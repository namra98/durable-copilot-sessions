{
  "name": "durable-copilot-sessions",
  "version": "0.1.0",
  "private": true,
  "description": "Save, snapshot, and one-click restore your Copilot CLI sessions across Windows Terminal windows and tabs - durable across reboots.",
  "type": "module",
  "bin": {
    "dcs": "dist/cli/rust-bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cargo run -p dcs-rs -- serve",
    "dev:web": "vite",
    "build": "npm run build:rust && npm run build:node && npm run build:web",
    "build:rust": "cargo build --release -p dcs-rs",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run rust:check && npm run build && npm run smoke:launcher",
    "setup": "npm install && npm run build && npm link",
    "start": "node dist/cli/rust-bin.js serve",
    "cli": "cargo run -p dcs-rs --",
    "ui": "node dist/cli/rust-bin.js ui",
    "lint": "eslint .",
    "rust:fmt": "cargo fmt --check",
    "rust:lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --all",
    "rust:smoke": "cargo test --test perf_smoke -- --nocapture",
    "rust:build": "cargo build --all",
    "rust:check": "npm run rust:fmt && npm run rust:lint && npm run rust:test && npm run rust:build",
    "smoke:launcher": "node dist/cli/rust-bin.js --help",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
